/* ============================================
   全局基础
   ============================================ */
   page {
    background-color: #F0F4FB;
    font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  }
  
  .page-container {
    padding: 32rpx 28rpx;
    min-height: 100vh;
  }
  
  /* ============================================
     天气卡片
     ============================================ */
  .weather-card {
    background: linear-gradient(135deg, #1A78E5 0%, #0F52BA 60%, #0A3D8F 100%);
    border-radius: 32rpx;
    padding: 36rpx 40rpx;
    color: #ffffff;
    margin-bottom: 8rpx;
    box-shadow: 0 8rpx 32rpx rgba(26, 120, 229, 0.35);
  }
  
  .weather-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
  }
  
  .weather-location {
    display: flex;
    align-items: center;
    gap: 8rpx;
  }
  
  .location-icon {
    font-size: 28rpx;
  }
  
  .location-name {
    font-size: 28rpx;
    font-weight: 500;
    opacity: 0.95;
  }
  
  .weather-time {
    font-size: 22rpx;
    background: rgba(255,255,255,0.2);
    border-radius: 20rpx;
    padding: 4rpx 20rpx;
    opacity: 0.9;
  }
  
  .weather-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28rpx;
  }
  
  .weather-temp {
    font-size: 110rpx;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -2rpx;
  }
  
  .weather-desc {
    font-size: 30rpx;
    opacity: 0.85;
    margin-top: 8rpx;
  }
  
  .weather-stats {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding-bottom: 12rpx;
  }
  
  .weather-stat-item {
    text-align: center;
  }
  
  .stat-label {
    font-size: 22rpx;
    opacity: 0.7;
    margin-bottom: 6rpx;
  }
  
  .stat-value {
    font-size: 30rpx;
    font-weight: 600;
  }
  
  .weather-stat-divider {
    width: 1rpx;
    height: 48rpx;
    background: rgba(255,255,255,0.3);
  }
  
  .weather-tips {
    display: flex;
    align-items: center;
    gap: 12rpx;
    background: rgba(255,255,255,0.15);
    border-radius: 16rpx;
    padding: 14rpx 20rpx;
  }
  
  .tips-icon {
    font-size: 28rpx;
    flex-shrink: 0;
  }
  
  .tips-text {
    font-size: 24rpx;
    opacity: 0.9;
    letter-spacing: 0.5rpx;
  }
  
  /* ============================================
     区块标题行
     ============================================ */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 40rpx 4rpx 20rpx;
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1A2340;
  }
  
  /* 设备在线/离线标签 */
  .device-badge {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 6rpx 20rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
  }
  
  .badge-online {
    background: #E6F9EE;
    color: #18A850;
  }
  
  .badge-offline {
    background: #FDECEA;
    color: #E53935;
  }
  
  .badge-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
  }
  
  .badge-online .badge-dot { background: #18A850; }
  .badge-offline .badge-dot { background: #E53935; }
  
  /* ============================================
     数据卡片网格（2列 — 环境监测）
     ============================================ */
  .data-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20rpx;
  }
  
  .data-card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 28rpx 24rpx;
    display: flex;
    flex-direction: column;
    gap: 16rpx;
    box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
    min-height: 160rpx;
  }
  
  .card-icon-wrap {
    width: 72rpx;
    height: 72rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .card-icon {
    width: 44rpx;
    height: 44rpx;
  }
  
  /* emoji 替代图标（MQ2传感器暂无图标图片时使用） */
  .card-emoji {
    font-size: 36rpx;
    line-height: 1;
  }
  
  /* ---- 各卡片主题色 ---- */
  .icon-temp     { background: #FFF0E6; }
  .icon-humidity { background: #E6F4FF; }
  .icon-light    { background: #FFFBE6; }
  .icon-smoke    { background: #F2F2F2; }
  .icon-methane  { background: #FFF0F0; }
  .icon-propane  { background: #EDF0FF; }
  
  .card-label {
    font-size: 24rpx;
    color: #9AA3B5;
    margin-bottom: 4rpx;
  }
  
  .card-value {
    font-size: 52rpx;
    font-weight: 700;
    color: #1A2340;
    line-height: 1.1;
  }
  
  .card-unit {
    font-size: 26rpx;
    font-weight: 400;
    color: #9AA3B5;
    margin-left: 4rpx;
  }
  
  /* ============================================
     气体安全检测卡片（危险/正常双状态）
     ============================================ */
  .danger-alert {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-top: 20rpx;
    padding: 28rpx 28rpx;
    border-radius: 24rpx;
  }
  
  /* -- 危险状态 -- */
  .danger-active {
    background: linear-gradient(135deg, #FF3B30 0%, #E53935 100%);
    box-shadow: 0 4rpx 20rpx rgba(229, 57, 53, 0.4);
    animation: danger-pulse 1.2s ease-in-out infinite alternate;
  }
  
  @keyframes danger-pulse {
    from { box-shadow: 0 4rpx 20rpx rgba(229, 57, 53, 0.4); }
    to   { box-shadow: 0 8rpx 36rpx rgba(229, 57, 53, 0.65); }
  }
  
  .danger-active .danger-icon-wrap {
    animation: danger-shake 0.5s ease-in-out infinite;
  }
  
  @keyframes danger-shake {
    0%, 100% { transform: rotate(0deg);  }
    25%      { transform: rotate(-8deg); }
    75%      { transform: rotate(8deg);  }
  }
  
  /* -- 正常状态 -- */
  .danger-safe {
    background: linear-gradient(135deg, #34C759 0%, #30B350 100%);
    box-shadow: 0 2rpx 12rpx rgba(52, 199, 89, 0.3);
  }
  
  .danger-icon-wrap {
    font-size: 52rpx;
    flex-shrink: 0;
  }
  
  .danger-info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
  }
  
  .danger-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #ffffff;
  }
  
  .danger-desc {
    font-size: 24rpx;
    color: rgba(255,255,255,0.85);
  }
  
  /* ============================================
     控制面板
     ============================================ */
  .control-panel {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 0 28rpx;
    box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
  }
  
  .control-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0;
  }
  
  .control-left {
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .control-icon-wrap {
    width: 72rpx;
    height: 72rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .control-icon {
    width: 42rpx;
    height: 42rpx;
  }
  
  .icon-led1 { background: #FFF8E0; }
  .icon-jdq  { background: #FFF0F0; }
  .icon-led2 { background: #E6F0FF; }
  
  .control-info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
  }
  
  .control-name {
    font-size: 30rpx;
    font-weight: 500;
    color: #1A2340;
  }
  
  .control-desc {
    font-size: 24rpx;
    color: #9AA3B5;
  }
  
  .control-divider {
    height: 1rpx;
    background: #F2F4F8;
    margin: 0 -28rpx;
  }
  
  /* ============================================
     亮度调节卡片
     ============================================ */
  .brightness-card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 28rpx;
    box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
    margin-top: 20rpx;
  }
  
  .brightness-header {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-bottom: 28rpx;
  }
  
  .brightness-info {
    flex: 1;
  }
  
  .brightness-value-badge {
    background: #EBF3FF;
    color: #1A78E5;
    font-size: 26rpx;
    font-weight: 600;
    padding: 8rpx 22rpx;
    border-radius: 20rpx;
    min-width: 80rpx;
    text-align: center;
  }
  
  .brightness-slider-wrap {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .slider-label {
    font-size: 22rpx;
    color: #C0C7D4;
    width: 60rpx;
    flex-shrink: 0;
    text-align: center;
  }
  
  .brightness-slider {
    flex: 1;
    margin: 0;
  }
  